<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/white"
                android:textSize="26sp" />

            <TextView
                style="@style/TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin panel" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:alpha="0.9"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/swCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_cat"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                style="@style/TextCardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⭐ Pro rejimi (sinov)" />

            <Switch
                android:id="@+id/swPro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_cat"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📢 Reklama joylash" />

            <TextView
                style="@style/TextCardBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tez orada (server kerak)" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardNotify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_cat"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔 Bildirishnoma yuborish" />

            <TextView
                style="@style/TextCardBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tez orada (server kerak)" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_cat"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextCardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 Foydalanuvchilar" />

            <TextView
                style="@style/TextCardBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tez orada (server kerak)" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
