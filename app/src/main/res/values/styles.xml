<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Butun ilova mavzusi -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:statusBarColor">@color/orange</item>
        <item name="android:navigationBarColor">@color/orange_dark</item>
    </style>

    <!-- Matn uslublari -->
    <style name="TextTitle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextCardTitle">
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextCardBody">
        <item name="android:textColor">@color/text_gray</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Tugma uslublari -->
    <style name="BtnOrange">
        <item name="android:background">@drawable/btn_orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
